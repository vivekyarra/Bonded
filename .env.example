# Qloo Taste AI. Server-side only, never exposed to the browser.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Google Gemini (agent orchestration and phrasing only; free tier works).
# Get a key at https://aistudio.google.com/apikey. Without a key the agent runs in
# deterministic mode: same tools, same Qloo data, templated wording.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional. "live" (default) uses Qloo + the bundled cache. "fixture" is the offline
# mode used by CI (src/lib/qloo/fixture.ts); the app labels it on every page.
QLOO_MODE=live
