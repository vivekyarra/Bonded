# Qloo Taste AI (hackathon server). Server-side only, never exposed to the browser.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Claude (agent orchestration and phrasing only). Without a key the agent runs in
# deterministic mode: same tools, same Qloo data, templated wording.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional. "live" (default) uses Qloo + the bundled cache. "fixture" uses the offline
# test graph in src/lib/qloo/fixture.ts and shows a FIXTURE banner on every page.
QLOO_MODE=live
